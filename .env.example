# Local benchmark credentials only. Install as mode 600 and replace before starting.
POSTGRES_PASSWORD=replace-with-local-only-password
# Optional overrides. Blank values derive distinct one-way local role passwords
# in memory; connector passwords are never written to result artifacts.
CDC_PASSWORD=
SINK_PASSWORD=
TABLE_COUNT=5
SOURCE_BACKLOG_PER_TABLE=1000
SINK_BACKLOG_PER_TABLE=2000
CONNECT_OFFSET_FLUSH_INTERVAL_MS=1000
CONNECT_OFFSET_FLUSH_TIMEOUT_MS=5000
CONNECT_SCHEDULED_REBALANCE_MAX_DELAY_MS=30000
CONNECT_SESSION_TIMEOUT_MS=10000
CONNECT_HEARTBEAT_INTERVAL_MS=3000
CONNECT_WORKER_HEAP_OPTS=-Xms256M -Xmx768M
KAFKA_BROKER_HEAP_OPTS=-Xms256M -Xmx512M
CONNECT_INTERNAL_TOPIC_REPLICATION_FACTOR=1
CONNECT_CONFIG_STORAGE_PARTITIONS=1
CONNECT_OFFSET_STORAGE_PARTITIONS=25
CONNECT_STATUS_STORAGE_PARTITIONS=5
SINK_TASKS_MAX=1
SINK_BATCH_SIZE=500
SINK_POOL_MIN_SIZE=1
SINK_POOL_MAX_SIZE=4
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_MIN_INSYNC_REPLICAS=1
