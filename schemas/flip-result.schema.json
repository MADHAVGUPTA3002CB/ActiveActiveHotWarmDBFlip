{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.flipbench/flip-result.schema.json",
  "title": "Flipbench result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "outcome",
    "profile",
    "table_count",
    "stages_ns",
    "detach_ns_by_table",
    "target_next_offsets",
    "final_committed_next_offsets",
    "ownership_outcome",
    "verification_outcome",
    "gc_eligible",
    "topology",
    "connect_worker_config",
    "error"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "format": "uuid"},
    "attempt_id": {"type": "string", "format": "uuid"},
    "attempt_epoch": {"type": ["integer", "null"], "minimum": 1},
    "outcome": {"enum": ["success", "failed", "reverted"]},
    "profile": {"enum": ["local-rf1-paused-backlog", "local-rf1-running", "local-rf1-healthy-overload", "local-rf1-production-shaped", "local-rf3-single-host-production-shaped"]},
    "table_count": {"enum": [5, 10, 15, 20]},
    "stages_ns": {"type": "object"},
    "durations_ns": {"type": "object"},
    "detach_ns_by_table": {"type": "object"},
    "target_next_offsets": {"type": "object"},
    "final_committed_next_offsets": {"type": "object"},
    "ownership_outcome": {"enum": ["success", "failed", "reverted"]},
    "verification_outcome": {"enum": ["not_run", "passed", "failed"]},
    "gc_eligible": {"type": "boolean"},
    "topology": {"type": "object"},
    "connect_worker_config": {"type": "object"},
    "error": {"type": ["object", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "success"}}},
      "then": {
        "properties": {
          "ownership_outcome": {"const": "success"},
          "error": {"type": "null"}
        }
      },
      "else": {"properties": {"error": {"type": "object"}}}
    }
  ],
  "additionalProperties": true
}
